APP_ENV=development
API_HOST=0.0.0.0
PORT=8080
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_MAX_CONNS=5
TABLE_ACTOR_QUEUE_CAPACITY=64
TABLE_ACTOR_IDLE_TIMEOUT=10m
REALTIME_READ_LIMIT_BYTES=8192
REALTIME_OUTBOUND_QUEUE_CAPACITY=64
REALTIME_OUTBOUND_QUEUE_BYTES=262144
REALTIME_WRITE_TIMEOUT=5s
REALTIME_PING_INTERVAL=20s
REALTIME_PONG_TIMEOUT=10s
REALTIME_MAX_CONNECTIONS=256
REALTIME_MAX_CONNECTIONS_PER_SESSION=3
REALTIME_MESSAGE_RATE=10
REALTIME_MESSAGE_BURST=20
REALTIME_RECOVERY_LIMIT=128
AUTH_SECRET=replace-with-at-least-32-random-characters
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
READ_HEADER_TIMEOUT=5s
READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
